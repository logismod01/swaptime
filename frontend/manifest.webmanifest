{
  "name": "СвапТайм — мессенджер",
  "short_name": "СвапТайм",
  "description": "Мессенджер: личные чаты, серверы как в Discord, каналы как в Telegram, звонки и демонстрация экрана до 4K.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0b12",
  "theme_color": "#0b0b12",
  "lang": "ru",
  "dir": "ltr",
  "categories": ["social", "communication"],
  "icons": [
    { "src": "/static/icons/icon-64.png", "sizes": "64x64", "type": "image/png" },
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/static/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Личные сообщения", "url": "/?view=chats", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Каналы", "url": "/?view=tg", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Друзья", "url": "/?view=friends", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
